{
  "expo": {
    "name": "FixItNow",
    "slug": "fixit-now-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fixitnow",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.fixitnow.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
